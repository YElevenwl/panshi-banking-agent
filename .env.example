# 服务
PORT=8787
PANSHI_DB=data/panshi.db
PANSHI_DEMO_NOW=2026-10-31T09:00:00+08:00

# LLM：mock（默认，离线可复现）或 openai（OpenAI-compatible）
PANSHI_LLM=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_PATH=/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 严格模式：真实模型失败时不回退 Mock（评测用）
PANSHI_LLM_STRICT=0
PANSHI_LLM_TIMEOUT_MS=30000
# 公共免费端点限流时使用（毫秒）；0 表示不限制
PANSHI_LLM_MIN_INTERVAL_MS=0

# 密钥：生产必须更换
PANSHI_PERMIT_SECRET=dev-permit-secret-change-me
PANSHI_SESSION_SECRET=dev-session-secret-change-me
