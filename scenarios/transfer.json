    {"id": "N2", "title": "解析收款人", "deps": ["N1"], "permission": "green"},
    {"id": "N3", "title": "计算风险事实", "deps": ["N2"], "permission": "none"},
    {"id": "N4", "title": "策略裁决", "deps": ["N3"], "permission": "policy_gate"},
    {"id": "N5", "title": "审批与强验证", "deps": ["N4"], "permission": "yellow/red"},
