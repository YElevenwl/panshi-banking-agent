{
  "name": "birthday",
  "title": "跨场景联动：生日计划",
  "entry_intents": ["birthday.plan"],
  "demo_prompts": [
    "我爱人生日快到了，帮我准备，预算 1000 元",
    "授权读取日历",
    "确认生日计划"
  ],
  "nodes": [
    {"id": "P0", "title": "绑定会话", "deps": [], "permission": "none"},
    {"id": "P1", "title": "理解生日计划", "deps": ["P0"], "permission": "green"},
    {"id": "P2", "title": "读取日历（需授权）", "deps": ["P1"], "permission": "user_consent"},
    {"id": "P3", "title": "计划审批", "deps": ["P2"], "permission": "yellow"},
    {"id": "P4", "title": "创建消费授权", "deps": ["P3"], "permission": "permit"},
    {"id": "P5", "title": "冻结预算", "deps": ["P4"], "permission": "permit"},
    {"id": "P6", "title": "安排定时下单", "deps": ["P5"], "permission": "permit"},
    {"id": "P7", "title": "生日计划回执", "deps": ["P6"], "permission": "output_check"},
    {"id": "P8", "title": "审计锚定", "deps": ["P7"], "permission": "audit"}
  ],
  "mandate": {
    "scope": "merchant_categories flower/cake",
    "max_cents": 100000,
    "expires": "event_date end of day",
    "auto_commit": "到期调度器重新评估 Policy Gate，匹配额度/类别/时间窗"
  },
  "rollback": [
    "order.schedule -> order.cancel",
    "ledger.hold -> ledger.release_hold",
    "mandate.create -> mandate.revoke"
  ],
  "interrupts": ["日历授权", "计划审批", "价格/额度变化", "用户取消"]
}
