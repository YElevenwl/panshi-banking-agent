{
  "name": "bill",
  "title": "账单分析",
  "entry_intents": ["bill.analyze", "bill.anomaly"],
  "demo_prompts": [
    "上个月账单花了多少",
    "上个月有没有可疑消费",
    "本月账单",
    "上个月餐饮花了多少"
  ],
  "nodes": [
    {"id": "B0", "title": "绑定会话", "deps": [], "permission": "none"},
    {"id": "B1", "title": "理解账单意图", "deps": ["B0"], "permission": "green"},
    {"id": "B2", "title": "查询与聚合", "deps": ["B1"], "permission": "green"},
    {"id": "B3", "title": "证据锚定账单报告", "deps": ["B2"], "permission": "output_check"},
    {"id": "B4", "title": "审计锚定", "deps": ["B3"], "permission": "audit"}
  ],
  "permissions": {
    "green": "纯查询自动执行，无审批",
    "red": "不适用",
    "deny": "跨用户账单、批量用户信息"
  },
  "anomaly_rules": [
    "同一商户/金额/日期多笔 -> duplicate_charge",
    "凌晨 0-5 点且金额 >= 500 元 -> late_night_large",
    "商户信息不完整 -> unknown_merchant",
    "金额 > 同类平均 3 倍 -> category_outlier"
  ],
  "rollback": ["无副作用，不涉及补偿"]
}
